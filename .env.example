# SmartPark Kenya – environment configuration
# Copy to .env and fill in real values. Never commit .env.

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database (Supabase PostgreSQL = single source of truth) ----------------
# Supabase Dashboard -> Settings -> Database
#   * dedicated host db.<ref>.supabase.co is IPv6-ONLY (fails on IPv4-only
#     machines with "Network is unreachable")
#   * so use the Connection pooler -> Session mode -> URI (port 5432):
#       postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# While empty, development falls back to local SQLite (bootstrap only).
DATABASE_URL=

# --- Flask services ---------------------------------------------------------
FEE_SERVICE_PORT=5000
BARRIER_SERVICE_PORT=5001
